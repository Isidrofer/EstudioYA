{
  "name": "estudioya",
  "version": "0.1.0",
  "private": true,
  "description": "EstudioYA: plataforma de clases particulares por y para estudiantes",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "build:shared": "npm run build -w @estudioya/shared",
    "build": "npm run build:shared && npm run build -w @estudioya/api && npm run build -w @estudioya/web",
    "dev:api": "npm run build:shared && npm run start:dev -w @estudioya/api",
    "dev:web": "npm run dev -w @estudioya/web",
    "typecheck": "npm run build:shared && npm run typecheck -w @estudioya/api && npm run typecheck -w @estudioya/web",
    "db:generate": "npm run prisma:generate -w @estudioya/api",
    "db:validate": "npm run prisma:validate -w @estudioya/api",
    "db:migrate": "npm run prisma:migrate -w @estudioya/api",
    "db:seed": "npm run prisma:seed -w @estudioya/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0"
  }
}
