# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Puertos ---
API_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- PostgreSQL ---
POSTGRES_USER=estudioya
POSTGRES_PASSWORD=estudioya_dev
POSTGRES_DB=estudioya
# Puerto del host. Si lo cambiás, cambialo también en DATABASE_URL.
POSTGRES_PORT=5433
# Se usa 127.0.0.1 (no "localhost") para evitar problemas de resolución IPv6 en Windows.
DATABASE_URL=postgresql://estudioya:estudioya_dev@127.0.0.1:5433/estudioya?schema=public

# --- RabbitMQ (local) ---
RABBITMQ_USER=estudioya
RABBITMQ_PASSWORD=estudioya_dev
RABBITMQ_URL=amqp://estudioya:estudioya_dev@localhost:5672

# --- Auth ---
JWT_ACCESS_SECRET=cambiar-en-local
JWT_REFRESH_SECRET=cambiar-en-local
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mercado Pago (credenciales de PRUEBA; ver docs/adr/0002-pagos-mercado-pago.md §9.2) ---
# Client ID y Client Secret de la aplicación (modelo Marketplace), en el entorno "Prueba"
MP_APP_ID=
MP_CLIENT_SECRET=
MP_PLATFORM_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=
# Debe coincidir EXACTAMENTE con la Redirect URL configurada en la aplicación
MP_OAUTH_REDIRECT_URL=http://localhost:4000/api/v1/payments/oauth/callback
# Clave (32 bytes en base64) para cifrar los tokens de Mercado Pago de los profesores.
# Generarla con: npm run spike:mp -w @estudioya/api -- gen-key
TOKEN_ENCRYPTION_KEY=

# --- Archivos privados (documentos de verificación). Solo desarrollo: carpeta local ---
STORAGE_DIR=./storage

# --- Primer administrador (opcional, solo desarrollo). Lo crea `npm run db:seed` ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (Mailpit local: UI en http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=EstudioYA <no-reply@estudioya.local>
